# ==========================================
# Environment / Configuration with secrets
# ==========================================
.env
.env.local
.env.*.local

# Keep application.properties tracked (uses env placeholders; no secrets).
# Ignore only local profile overrides that may contain secrets.
application-*.properties
!application.properties.example

