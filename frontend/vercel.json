{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://java-backend-production-54bf.up.railway.app/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://java-backend-production-54bf.up.railway.app/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://java-backend-production-54bf.up.railway.app/login/oauth2/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}